    {
      "id": "FR-1",
      "person": "thomas",
      "type": "Framework",
      "label": "The Obligation-Credibility Axis",
      "text": "Credibility = Intelligence × Obligation ÷ Insulation. Intelligence = reality-contact capacity (not IQ). Obligation = degree of consequence-bearing. Insulation = buffers from consequence. Credibility → 0 as insulation → ∞, or when obligation = 0.",
      "notes": "The Altitude Model: ground level = full consequence exposure = where credibility lives."
    },
